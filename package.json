{
  "name": "pixinsight-mcp",
  "version": "0.1.0",
  "description": "MCP server giving an AI agent full control over PixInsight: calibration, stacking, post-processing with visual feedback",
  "type": "module",
  "bin": { "pixinsight-mcp": "dist/index.js" },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --testTimeout=600000",
    "fixtures": "tsx tests/fixtures/gen.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": { "node": ">=20" },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
